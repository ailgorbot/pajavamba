#!/bin/sh
# Crochet de pré-commit (L0-14, RI-SCR-01) : bloque le commit si gitleaks détecte un secret dans l'index.
# Activation : git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pré-commit : gitleaks introuvable, détection locale des secrets ignorée (la CI reste bloquante)." >&2
  echo "Installer gitleaks 8.30.1 : https://github.com/gitleaks/gitleaks/releases" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
