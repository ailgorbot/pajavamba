{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "e799ceda890fc357d340c93cc222c5f0796281d7",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore(socle): publier la version ${version}",
  "pull-request-header": "Proposition de version générée par release-please à partir des commits fusionnés. La fusion reste une décision du mainteneur (RI-VER-06).",
  "packages": {
    ".": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Ajouts" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "revert", "section": "Annulations" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Remaniements", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Construction", "hidden": true },
        { "type": "ci", "section": "Intégration continue", "hidden": true },
        { "type": "chore", "section": "Divers", "hidden": true }
      ]
    }
  }
}
